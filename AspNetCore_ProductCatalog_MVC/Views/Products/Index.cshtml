@model IEnumerable<Product>

<p>
    <a href="@Url.Action("Create", "Products")" class="btn btn-primary">Add New Product</a>
</p>

<h3>Product List</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Product Name</th>
            <th>Serial No</th>
            <th>Category</th>
            <th>Mfg. Date</th>
            <th>Price</th>
            <th>Status</th>
            <th>Brands</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@Url.Content("~/images/" + item.ImageUrl)" width="80" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/noimage.png")" width="80" />
                    }
                </td>
                <td>@item.ProductName</td>
                <td>@item.SerialNo</td>
                <td>@item.Category.CategoryName</td>
                <td>@item.ManufacturingDate.ToShortDateString()</td>
                <td>@item.Price.ToString("C2")</td>
                <td>@(item.IsAvailable ? "Available" : "Out of Stock")</td>
                <td>
                    <ul class="mb-0">
                        @foreach (var b in item.Brands)
                        {
                            <li>@b.BrandName &mdash; @b.Stock</li>
                        }
                    </ul>
                </td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Edit", "Products", new { id = item.ProductId })" class="btn btn-primary">Edit</a>

                        <form method="post"
                              asp-action="Delete" asp-controller="Products"
                              asp-route-id="@item.ProductId"
                              onsubmit="return confirm('Are you sure you want to delete this record?')">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>